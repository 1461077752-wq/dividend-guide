---
import '../styles/global.css';
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  pubDate?: string;
  modDate?: string;
  schemaType?: 'Article' | 'WebPage';
  image?: string;
  noIndex?: boolean;
  locale?: 'en' | 'zh';
  pageClass?: string;
  alternates?: Array<{ hreflang: 'en' | 'zh-CN' | 'x-default'; href: string }>;
}
const currentPath = Astro.url.pathname;
const {
  title,
  description,
  canonical,
  pubDate = '2026-01-15',
  modDate = new Date().toISOString().split('T')[0],
  schemaType = 'WebPage',
  image,
  noIndex = false,
  locale = currentPath.startsWith('/zh') ? 'zh' : 'en',
  pageClass = '',
  alternates
} = Astro.props;
const isNotFoundPage = currentPath === '/404/' || currentPath === '/404.html' || currentPath === '/zh/404/';
const englishPath = currentPath.replace(/^\/zh(?=\/|$)/, '') || '/';
const currentYear = new Date().getFullYear();
const navItems = [
  { href: '/', label: 'Guide', icon: 'home' },
  { href: '/articles/', label: 'Articles', icon: 'article' },
  { href: '/stocks/', label: 'Stocks', icon: 'chart' },
  { href: '/calculator/', label: 'Calculator', icon: 'calc' },
  { href: '/strategy/', label: 'Strategy', icon: 'activity' },
];
const localizedNavItems = locale === 'zh'
  ? navItems.map(item => ({ ...item, href: item.href === '/' ? '/zh/' : `/zh${item.href}` }))
  : navItems;
const localizedPath = (path: string) => locale === 'zh' ? (path === '/' ? '/zh/' : `/zh${path}`) : path;

const pageNames: Record<string, string> = {
  '/': 'Dividend Guide',
  '/articles/': 'Articles',
  '/stocks/': 'Best Dividend Stocks',
  '/calculator/': 'Dividend Calculator',
  '/strategy/': 'Dividend Strategies',
  '/about/': 'About',
  '/contact/': 'Contact',
  '/privacy/': 'Privacy Policy',
  '/terms/': 'Terms of Use',
  '/about/author/': 'About the Author',
  '/editorial-standards/': 'Editorial Standards',
};

const breadcrumbItems = currentPath === '/'
  ? [{ name: 'Home', path: '/' }]
  : [
      { name: 'Home', path: '/' },
      { name: pageNames[currentPath] || title, path: currentPath.endsWith('/') ? currentPath : `${currentPath}/` }
    ];
const normalizeUrl = (value: string) => {
  const parsed = new URL(value);
  if (parsed.hostname === 'dividend01.com') parsed.hostname = 'www.dividend01.com';
  if (parsed.pathname !== '/' && !parsed.pathname.endsWith('/')) parsed.pathname += '/';
  return parsed.toString();
};
const englishUrl = normalizeUrl(`https://www.dividend01.com${englishPath}`);
const chineseUrl = normalizeUrl(`https://www.dividend01.com/zh${englishPath === '/' ? '/' : englishPath}`);
const languageHref = isNotFoundPage
  ? (locale === 'zh' ? 'https://www.dividend01.com/404.html' : 'https://www.dividend01.com/zh/404/')
  : locale === 'zh'
    ? englishUrl
    : chineseUrl;
const pageUrl = normalizeUrl(canonical || `https://www.dividend01.com${currentPath}`);
const ogImage = image || 'https://www.dividend01.com/images/dividend-hero.jpg';
const alternateLinks = alternates || (isNotFoundPage ? [] : [
  { hreflang: 'en' as const, href: englishUrl },
  { hreflang: 'zh-CN' as const, href: chineseUrl },
  { hreflang: 'x-default' as const, href: englishUrl }
]);
---
<!DOCTYPE html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>
  <meta name="description" content={description}>
  {noIndex && <meta name="robots" content="noindex, follow">}
  <meta name="author" content="Henry Zhou">
  <link rel="canonical" href={pageUrl}>
  {alternateLinks.map(alternate => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href}>)}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Font Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Open Graph / Social -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'}>
  <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'}>
  <meta property="og:site_name" content="Dividend Guide">
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Dividend Guide",
      "url": "https://www.dividend01.com",
      "description": "A practical, step-by-step guide to dividend investing.",
      "logo": "https://www.dividend01.com/favicon.svg"
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Dividend Guide",
      "url": "https://www.dividend01.com",
      "description": "A practical, step-by-step guide to dividend investing."
    },
    {
      "@context": "https://schema.org",
      "@type": schemaType,
      "headline": title,
      "description": description,
      "url": pageUrl,
      "inLanguage": locale === 'zh' ? 'zh-CN' : 'en',
      "datePublished": pubDate,
      "dateModified": modDate,
      "author": { "@type": "Person", "name": "Henry Zhou", "jobTitle": "Independent Dividend Researcher", "url": "https://www.dividend01.com/about/author/" },
      "publisher": { "@type": "Organization", "name": "Dividend Guide", "url": "https://www.dividend01.com/about/" }
    },
    ...(currentPath !== '/' ? [{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": normalizeUrl(`https://www.dividend01.com${item.path}`)
      }))
    }] : [])
  ])}></script>
</head>
<body class:list={[{ 'home-page': currentPath === '/' || currentPath === '/zh/', 'locale-zh': locale === 'zh' }, pageClass]}>
  <script is:inline>if(location.hostname.includes('pages.dev')){location.replace('https://www.dividend01.com'+location.pathname+location.search)}</script>
  <aside id="analytics-consent" hidden aria-label="Analytics preferences">
    <p>{locale === 'zh' ? '我们使用匿名分析来改进内容。你可以接受或拒绝。' : 'We use optional analytics to improve the site. You can accept or decline.'}</p>
    <button type="button" data-analytics-accept>{locale === 'zh' ? '接受分析' : 'Accept analytics'}</button>
    <button type="button" data-analytics-decline>{locale === 'zh' ? '拒绝' : 'Decline'}</button>
  </aside>
  <header class="site-header">
    <span class="sr-only">Stock market charts and financial data visualisation</span>
    <div class="container">
      <h1 data-i18n={currentPath === '/' ? 'home.title' : undefined}><slot name="title">Dividend Guide</slot></h1>
      <p class="subtitle" data-i18n={currentPath === '/' ? 'home.subtitle' : undefined}><slot name="subtitle">{description}</slot></p>
      <p class="byline">{locale === 'zh' ? '作者：' : 'By '}<a href={localizedPath('/about/author/')}>Henry Zhou</a>{locale === 'zh' ? ' · 独立股息研究员 · 更新于 ' : ' · Independent Dividend Researcher · Updated '}<time datetime={modDate}>{modDate}</time></p>
      <div class="hero-cta">
        <a href={localizedPath('/stocks/')} class="btn">{locale === 'zh' ? '浏览股票' : 'Browse Stocks'}</a>
        <a href={localizedPath('/calculator/')} class="btn btn-outline">{locale === 'zh' ? '试用计算器' : 'Try Calculator'}</a>
      </div>
    </div>
  </header>
  <nav class="site-nav">
    <div class="container">
      <a href={localizedPath('/')} class="nav-brand"><span class="nav-brand-mark">DG</span><span class="nav-brand-name">Dividend Guide</span></a>
      {localizedNavItems.map(item => (
        <a href={item.href} class:list={[{ active: currentPath === item.href || (currentPath !== '/' && item.href !== '/' && currentPath.startsWith(item.href)) }]}>
          {item.icon === 'home' && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>}
          {item.icon === 'article' && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>}
          {item.icon === 'chart' && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>}
          {item.icon === 'calc' && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><circle cx="8" cy="11" r="1"/><circle cx="12" cy="11" r="1"/><circle cx="16" cy="11" r="1"/><circle cx="8" cy="16" r="1"/><circle cx="12" cy="16" r="1"/><circle cx="16" cy="18" r="1"/></svg>}
          {item.icon === 'activity' && <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
          <span data-i18n={locale === 'en' ? `nav.${item.icon}` : undefined}>{item.label}</span>
        </a>
      ))}
      <div class="nav-actions">
        <a class="nav-language" href={languageHref} aria-label={locale === 'zh' ? 'Switch to English' : '切换到中文'}>{locale === 'zh' ? 'EN' : '中文'}</a>
        <a class="nav-cta" href={localizedPath('/stocks/')}>{locale === 'zh' ? '开始研究' : 'Explore research'}</a>
      </div>
    </div>
  </nav>
  <main class="container"><slot /></main>
  <footer class="site-footer">
    <div class="container footer-shell">
      <div class="footer-intro">
        <a class="footer-brand" href={localizedPath('/')} aria-label="Dividend Guide home"><span class="footer-brand-mark">DG</span><span>Dividend Guide</span></a>
        <p>{locale === 'zh' ? '仅供教育参考，不构成投资建议。投资前请务必自行研究。' : 'Educational content only. Not financial advice. Always do your own research before investing.'}</p>
        <a class="footer-author" href={localizedPath('/about/author/')}><span>{locale === 'zh' ? '独立研究 ' : 'Independent research by '}</span>Henry Zhou <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-group">
          <h2>{locale === 'zh' ? '探索' : 'Learn'}</h2>
          <a href={localizedPath('/topics/dividend-investing-basics/')}>{locale === 'zh' ? '基础知识' : 'Basics'}</a>
          <a href={localizedPath('/topics/dividend-stock-screening/')}>{locale === 'zh' ? '股票筛选' : 'Screening'}</a>
          <a href={localizedPath('/topics/high-yield-dividend-stocks/')}>{locale === 'zh' ? '高股息' : 'High Yield'}</a>
          <a href={localizedPath('/topics/dividend-etf-history/')}>{locale === 'zh' ? 'ETF 历史' : 'ETF History'}</a>
        </div>
        <div class="footer-group">
          <h2>{locale === 'zh' ? '关于' : 'About'}</h2>
          <a href={localizedPath('/about/')}>{locale === 'zh' ? '关于指南' : 'About the guide'}</a>
          <a href={localizedPath('/about/author/')}>{locale === 'zh' ? '作者' : 'Author'}</a>
          <a href={localizedPath('/editorial-standards/')}>{locale === 'zh' ? '编辑标准' : 'Editorial Standards'}</a>
          <a href={localizedPath('/contact/')}>{locale === 'zh' ? '联系' : 'Contact'}</a>
        </div>
        <div class="footer-group">
          <h2>{locale === 'zh' ? '法律信息' : 'Legal'}</h2>
          <a href={localizedPath('/privacy/')}>{locale === 'zh' ? '隐私政策' : 'Privacy Policy'}</a>
          <a href={localizedPath('/terms/')}>{locale === 'zh' ? '使用条款' : 'Terms of Use'}</a>
        </div>
      </nav>
      <div class="footer-bottom">
        <span>&copy; {currentYear} Dividend Guide. {locale === 'zh' ? '保留所有权利。' : 'All rights reserved.'}</span>
      </div>
    </div>
  </footer>
</body>
