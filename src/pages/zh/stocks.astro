---
import BaseLayout from '../../layouts/BaseLayout.astro';
import marketData from '../../data/market-data.json';

const records = marketData.records;
const refreshed = new Date(marketData.refreshedAt);
const refreshedLabel = refreshed.toLocaleString('zh-CN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Shanghai' });
const groups = [
  { key: 'aristocrat', title: '股息贵族', description: '连续多年提高股息的成熟公司，重点观察盈利质量和估值。' },
  { key: 'high-yield', title: '高股息股票', description: '高收益率需要结合派息率、负债水平和现金流一起判断。' },
  { key: 'growth', title: '股息增长股票', description: '当前收益率可能不高，但公司具备持续提高分配的能力。' },
];
const money = (value) => value == null ? '—' : `$${value.toFixed(2)}`;
const yieldLabel = (record) => record.price && record.annualDividend ? `${(record.annualDividend / record.price * 100).toFixed(2)}%` : '—';
---
<BaseLayout title="最佳股息股票 - 股息投资指南" description="按最新市场价格、过去 12 个月股息率、派息率和股息增长记录了解精选股票。" canonical="https://dividend01.com/zh/stocks/" locale="zh" modDate="2026-08-18">
  <slot slot="title">最佳股息股票</slot>
  <slot slot="subtitle">用最新价格、过去 12 个月股息率、派息率和股息增长记录，建立自己的研究清单。</slot>
  <div class="page-intro"><p><strong>行情更新时间：</strong>{refreshedLabel}（北京时间） · 数据源：<a href="https://finance.yahoo.com/" target="_blank" rel="noopener">Yahoo Finance</a>。价格可能存在延迟；股息和派息率仅用于研究，请以发行方披露为准。</p></div>
  {groups.map((group) => <>
    <h2>{group.title}</h2>
    <p>{group.description}</p>
    <div class="table-wrapper"><table class="data-table"><thead><tr><th>代码</th><th>公司</th><th>行业</th><th>最新价</th><th>近 12 个月股息率</th><th>派息率</th><th>增长 / 频率</th></tr></thead><tbody>
      {records.filter((record) => record.category === group.key).map((record) => <tr><td><strong>{record.symbol}</strong></td><td>{record.company}</td><td>{record.sector}</td><td>{money(record.price)}</td><td class="positive">{yieldLabel(record)}</td><td>{record.payoutRatio}%</td><td>{record.secondary}</td></tr>)}
    </tbody></table></div>
  </>)}
  <p class="home-sources">近 12 个月股息率 = 过去 365 天现金分配 ÷ 最新市场价格，不代表未来分配预测。</p>
  <div class="tip-box"><strong>研究提醒：</strong>不要只根据收益率选股。可持续的派息率、稳定的股息增长记录和强劲的自由现金流更重要。</div>
</BaseLayout>
