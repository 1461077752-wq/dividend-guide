---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const articleTranslations: Record<string, { title: string; description: string }> = {
  'best-dividend-stocks-2025': { title: '2025 年最佳股息股票：年度回顾与精选', description: '回顾 2025 年表现最佳的股息股票，包括提高派息并交付收益的股息贵族和高收益股票。' },
  'dividend-dividend-stocks': { title: '股息股票：如何一步步筛选优质标的', description: '了解如何用收益率、派息率和增长年限筛选股息股票，并识别收益率陷阱。' },
  'dividend-yield': { title: '股息收益率：公式、用途与风险', description: '理解股息收益率的含义、计算方法、合理水平，以及高收益为何可能是风险信号。' },
  'high-dividend-stocks': { title: '高股息股票：收益率与风险指南', description: '按行业了解高收益股息股票，识别高收益陷阱，并降低股息削减风险。' },
  'highest-dividend-stocks': { title: '最高股息股票：数据与风险', description: '最高收益率股息股票——BDC、mREIT 和封闭式基金的收益率可达 10% 至 26%；了解收益率为何如此之高，以及为什么多数投资者最终会亏损。' }
};
const articleTranslation = articleTranslations[article.id];
const { Content } = await render(article);
const pubDate = article.data.pubDate.toISOString().split('T')[0];
const modDate = article.data.modDate
  ? article.data.modDate.toISOString().split('T')[0]
  : pubDate;
const reviewDate = article.data.reviewDate
  ? article.data.reviewDate.toISOString().split('T')[0]
  : modDate;
const relatedArticles = (await getCollection('articles'))
  .filter(candidate => !candidate.data.draft && candidate.id !== article.id)
  .map(candidate => {
    const sharedTags = candidate.data.tags.filter(tag => article.data.tags.includes(tag)).length;
    const sameCategory = candidate.data.category === article.data.category ? 2 : 0;
    return { candidate, score: sharedTags * 3 + sameCategory };
  })
  .sort((a, b) => b.score - a.score || b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf())
  .slice(0, 4)
  .map(item => item.candidate);
const topicGuides: Record<string, Array<{ href: string; label: string; description: string }>> = {
  'schd-dividend': [
    { href: '/articles/schd-dividend/', label: 'SCHD overview', description: 'Current distribution, fund design, and key risks' },
    { href: '/articles/schd-dividend-history/', label: 'SCHD dividend history', description: 'Split-adjusted annual and quarterly payments' },
    { href: '/articles/schd-dividend-yield/', label: 'SCHD yield', description: 'Current yield, historical range, and ETF comparison' },
  ],
};
const topicGuideKey = article.id.startsWith('schd-dividend') ? 'schd-dividend' : '';
const topicGuide = topicGuides[topicGuideKey];
---
<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  canonical={`https://www.dividend01.com/articles/${article.id}/`}
  pubDate={pubDate}
  modDate={modDate}
  image={article.data.image}
  author={article.data.author}
  authorRole={article.data.authorRole}
  review={article.data.review}
  reviewDate={reviewDate}
  dataAsOf={article.data.dataAsOf}
  methodology={article.data.methodology}
  sources={article.data.sources.map(source => ({ ...source, accessed: source.accessed?.toISOString().split('T')[0] }))}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/articles/">Articles</a><span aria-hidden="true">/</span><span data-article-text-en={article.data.title} data-article-text-zh={articleTranslation?.title}>{article.data.title}</span>
  </nav>
  <div class="article-header">
    <h1 data-article-text-en={article.data.title} data-article-text-zh={articleTranslation?.title}>{article.data.title}</h1>
    <p class="article-desc" data-article-text-en={article.data.description} data-article-text-zh={articleTranslation?.description}>{article.data.description}</p>
    <div class="article-meta-bar">
      <span class="article-category">{article.data.category}</span>
      <span>By <a href="/about/author/">{article.data.author}</a></span>
      <span>{article.data.authorRole}</span>
      <span>{article.data.review}</span>
      <span>Fact-checked {reviewDate}</span>
      <time datetime={pubDate}>
        {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {article.data.modDate && <span>Updated {article.data.modDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
      {article.data.dataAsOf && <span>Data through {article.data.dataAsOf}</span>}
      {article.data.tags.length > 0 && (
        <span class="article-tags">
          {article.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </span>
      )}
    </div>
    {article.data.image && (
      <img src={article.data.image} alt={article.data.title} class="article-cover" loading="eager">
    )}
  </div>
  {topicGuide && (
    <aside class="article-research-notes" aria-labelledby="topic-guide-heading">
      <h2 id="topic-guide-heading">Choose the right SCHD research page</h2>
      <ul>
        {topicGuide.map(item => (
          <li><a href={item.href} aria-current={item.href === `/articles/${article.id}/` ? 'page' : undefined}>{item.label}</a>: {item.description}</li>
        ))}
      </ul>
    </aside>
  )}
  <article class="article-content article-content-en">
    <Content />
  </article>
  <aside class="article-research-notes">
    <h2>Sources and methodology</h2>
    <p>{article.data.review}. This article is for educational purposes and is not personalized financial advice.</p>
    {article.data.reviewDate && <p>Fact-check date: {article.data.reviewDate.toISOString().split('T')[0]}</p>}
    {article.data.methodology && <p>Methodology: {article.data.methodology}</p>}
    {article.data.sources.length > 0 ? <ul>{article.data.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>{source.accessed ? ` (accessed ${source.accessed.toISOString().split('T')[0]})` : ''}</li>)}</ul> : <p>Primary data sources and the applicable calculation basis are documented in the article text where figures are used.</p>}
  </aside>
  <section class="related-articles" aria-labelledby="related-heading">
    <h2 id="related-heading">Related articles</h2>
    <div class="related-article-grid">
      {relatedArticles.map(related => (
        <a class="related-article-card" href={`/articles/${related.id}/`}>
          <span class="article-category">{related.data.category}</span>
          <strong>{related.data.title}</strong>
          <span>{related.data.description}</span>
        </a>
      ))}
    </div>
  </section>
  <div class="article-nav">
    <a href="/articles/" class="btn btn-outline">&larr; All Articles</a>
    <a href="/stocks/" class="btn">Browse Stocks</a>
  </div>
</ArticleLayout>
