---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dividend Calculator: Yield, DRIP &amp; Annual Income Projections" description="Free dividend calculator to compute yield, annual income, DRIP compound growth, and retirement income goals. Project your dividend returns over 20 years." canonical="https://dividendguide.com/calculator" schemaType="WebPage" pubDate="2026-01-15" modDate="2026-07-27">
  <slot slot="title">Dividend Calculator</slot>
  <slot slot="subtitle">Calculate dividend yield, annual income, and project compound growth with DRIP over the next 20 years.</slot>
  <section class="calc-section"><h2>Dividend Yield &amp; Annual Income</h2><div class="calc-row"><div class="calc-field"><label for="sp">Stock Price ($)</label><input type="number" id="sp" value="100" min="0.01" step="0.01"></div><div class="calc-field"><label for="ad">Annual Dividend / Share ($)</label><input type="number" id="ad" value="4" min="0" step="0.01"></div><div class="calc-field"><label for="sh">Shares Owned</label><input type="number" id="sh" value="100" min="1" step="1"></div></div><button class="btn" id="by">Calculate</button><div class="calc-result" id="yr" style="display:none"></div></section>
  <section class="calc-section"><h2>DRIP Compound Growth Projection</h2><p style="font-size:.9rem;color:var(--text-muted);margin-bottom:16px;">See how reinvesting dividends grows your position over time.</p><div class="calc-row"><div class="calc-field"><label for="di">Initial Investment ($)</label><input type="number" id="di" value="10000" min="1" step="1"></div><div class="calc-field"><label for="dy">Dividend Yield (%)</label><input type="number" id="dy" value="4" min="0.1" step="0.1"></div><div class="calc-field"><label for="dg">Annual Dividend Growth (%)</label><input type="number" id="dg" value="6" min="0" step="0.1"></div><div class="calc-field"><label for="ye">Years to Project</label><input type="number" id="ye" value="20" min="1" max="40" step="1"></div></div><button class="btn" id="bd">Project Growth</button><div class="calc-result" id="dr" style="display:none"></div></section>
  <section class="calc-section"><h2>Income Goal Calculator</h2><p style="font-size:.9rem;color:var(--text-muted);margin-bottom:16px;">How much capital do you need to reach your target annual dividend income?</p><div class="calc-row"><div class="calc-field"><label for="gi">Target Annual Income ($)</label><input type="number" id="gi" value="50000" min="1" step="1"></div><div class="calc-field"><label for="gy">Expected Portfolio Yield (%)</label><input type="number" id="gy" value="4" min="0.1" step="0.1"></div></div><button class="btn" id="bg">Calculate Required Capital</button><div class="calc-result" id="gr" style="display:none"></div></section>
</BaseLayout>
<script>
function fc(n){return '$'+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});}
document.getElementById('by').onclick=()=>{let p=+document.getElementById('sp').value||0,d=+document.getElementById('ad').value||0,s=+document.getElementById('sh').value||0,e=document.getElementById('yr');if(p<=0||s<=0){e.style.display='none';return}let y=(d/p)*100,a=d*s;e.style.display='block';e.innerHTML='<strong>Dividend Yield:</strong> '+y.toFixed(2)+'% &nbsp;|&nbsp; <strong>Annual Income:</strong> '+fc(a)+' &nbsp;|&nbsp; <strong>Quarterly:</strong> '+fc(a/4)+' &nbsp;|&nbsp; <strong>Monthly:</strong> '+fc(a/12);};
document.getElementById('bd').onclick=()=>{let i=+document.getElementById('di').value||0,y=+document.getElementById('dy').value||0,g=+document.getElementById('dg').value||0,Y=+document.getElementById('ye').value||0,e=document.getElementById('dr');if(i<=0||Y<=0){e.style.display='none';return}let v=i,td=0,cy=y/100;for(let j=1;j<=Y;j++){let dv=v*cy;td+=dv;v+=dv;cy*=(1+g/100)}e.style.display='block';e.innerHTML='After <strong>'+Y+' years</strong>: <strong>'+fc(v)+'</strong> (initial: '+fc(i)+'). Total dividends: <strong>'+fc(td)+'</strong>. Annual income at year '+Y+': <strong>'+fc(v*cy)+'</strong>.';};
document.getElementById('bg').onclick=()=>{let i=+document.getElementById('gi').value||0,y=+document.getElementById('gy').value||0,e=document.getElementById('gr');if(i<=0||y<=0){e.style.display='none';return}let c=i/(y/100);e.style.display='block';e.innerHTML='To generate <strong>'+fc(i)+'/year</strong> at <strong>'+y.toFixed(1)+'%</strong>, you need ~<strong>'+fc(c)+'</strong> invested.';};
</script>
