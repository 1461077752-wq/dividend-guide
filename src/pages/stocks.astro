---
import BaseLayout from '../layouts/BaseLayout.astro';
import marketData from '../data/market-data.json';

const records = marketData.records;
const refreshed = new Date(marketData.refreshedAt);
const refreshedLabel = refreshed.toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/New_York' });
const groups = [
  { key: 'aristocrat', title: 'Dividend Aristocrats', description: 'These S&P 500 companies have raised dividends every year for 25+ consecutive years.' },
  { key: 'high-yield', title: 'High-Yield Dividend Stocks', description: 'Higher income can come with higher risk. Check coverage, debt, and cash flow before comparing yields.' },
  { key: 'growth', title: 'Dividend Growth Stocks', description: 'Lower current yields can be paired with faster dividend growth and stronger reinvestment potential.' },
];
const money = (value) => value == null ? '—' : `$${value.toFixed(2)}`;
const yieldLabel = (record) => record.price && record.annualDividend ? `${(record.annualDividend / record.price * 100).toFixed(2)}%` : '—';
---
<BaseLayout title="Best Dividend Stocks 2026: Aristocrats &amp; High Yield" description="Curated list of dividend stocks with refreshed market prices, trailing annual dividend rates, payout ratios, and dividend growth context." canonical="https://www.dividend01.com/stocks/" schemaType="WebPage" pubDate="2026-07-27" modDate="2026-08-18">
  <slot slot="title">Best Dividend Stocks</slot>
  <slot slot="subtitle">A research list with refreshed market prices and trailing 12-month dividend rates. It is not a buy or sell recommendation.</slot>
  <div class="page-intro"><p><strong>Market data refreshed:</strong> {refreshedLabel} ET · Source: <a href="https://finance.yahoo.com/" target="_blank" rel="noopener">Yahoo Finance</a>. Prices may be delayed; dividend and payout figures are research estimates and should be verified with the issuer.</p></div>
  {groups.map((group) => <>
    <h2>{group.title}</h2>
    <p>{group.description}</p>
    <div class="table-wrapper"><table class="data-table"><thead><tr><th>Ticker</th><th>Company</th><th>Sector</th><th>Price</th><th>TTM Yield</th><th>Payout Ratio</th><th>Growth / Frequency</th></tr></thead><tbody>
      {records.filter((record) => record.category === group.key).map((record) => <tr><td><strong>{record.symbol}</strong></td><td>{record.company}</td><td>{record.sector}</td><td>{money(record.price)}</td><td class="positive">{yieldLabel(record)}</td><td>{record.payoutRatio}%</td><td>{record.secondary}</td></tr>)}
    </tbody></table></div>
  </>)}
  <p class="home-sources">TTM yield = trailing 12-month cash distributions ÷ latest market price. This calculation does not forecast future distributions.</p>
  <div class="tip-box"><strong>Research reminder:</strong> Don't pick stocks by yield alone. A sustainable payout ratio, consistent dividend growth history, and strong free cash flow matter more.</div>
</BaseLayout>
